# Copy to .env and adjust as needed. docker-compose.yml reads these; the individual
# apps/api and apps/web packages also read a subset directly when run outside Docker (npm run dev:api / dev:web).

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=simorgh
POSTGRES_PASSWORD=simorgh_dev_password
POSTGRES_DB=simorgh_grid
POSTGRES_PORT=5432
# Full connection string used directly by apps/api, db/migrate.ts and db/seed when run outside Docker:
DATABASE_URL=postgres://simorgh:simorgh_dev_password@localhost:5432/simorgh_grid

# --- Redis (live dashboard pub/sub, rate limiting) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible object storage for COMTRADE files and generated reports) ---
MINIO_ROOT_USER=simorgh_minio
MINIO_ROOT_PASSWORD=simorgh_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- API service ---
API_PORT=4000
# CHANGE THIS in any non-local deployment. Used to sign JWTs.
JWT_SECRET=dev-only-insecure-secret-change-me

# DANGER. Leave this unset.
# Authentication is required by default. Setting SIMORGH_PUBLIC_READS=true makes the dashboard, map,
# projects, relays, faults, alarms, work orders and the executive summary readable BY ANYONE who can
# reach the server, with no sign-in. It exists only for an offline demo on an isolated laptop, and
# the API logs a warning on every start while it is on.
# SIMORGH_PUBLIC_READS=true
# Optional. Refresh tokens are signed with a key derived from JWT_SECRET when this is unset, which
# keeps them from being interchangeable with access tokens. Set it to sign them with an independent
# key. Changing either value signs everyone out once; it does not affect stored data.
# JWT_REFRESH_SECRET=

# Optional. How long the startup screen shows each stage, and how long it holds at 100% (ms).
# Four stages plus the hold is about five seconds by default. Set the stage value to 0 to skip.
# NEXT_PUBLIC_WELCOME_STAGE_MS=900
# NEXT_PUBLIC_WELCOME_HOLD_MS=1200

# Optional. By default the session survives closing the browser, so a returning user goes straight
# from the welcome screen to the dashboard without signing in again. Set this to true and the
# session ends with the browser window, making every launch: welcome -> sign in -> dashboard.
# Recommended for a shared workstation or control room.
# NEXT_PUBLIC_SESSION_ENDS_ON_CLOSE=true
CORS_ORIGIN=http://localhost:3000
# Phase 1 default: GET endpoints are open for easy demo browsing; write endpoints always require auth+RBAC.
# Set to true to require authentication for reads as well.
REQUIRE_AUTH_FOR_READS=false
# Phase-1 local-evaluation live feed (see apps/api/src/ws/liveFeed.ts). Set to false to disable.
SIMULATE_LIVE_FEED=true
LIVE_FEED_INTERVAL_MS=12000
RATE_LIMIT_PER_MINUTE=600
# direct = write straight to Postgres/Redis (Phase 1 default, no broker needed).
# kafka  = route through Kafka/Redpanda (Phase 2+, requires standing up a broker — see docs/ARCHITECTURE.md §12).
EVENT_BUS=direct

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# --- Adminer (optional DB browser) ---
ADMINER_PORT=8081

# ---------------------------------------------------------------------------------------------
# Phase 2 — event bus, gateway ingest, and AI
# ---------------------------------------------------------------------------------------------

# Event transport between the Edge Gateway and the backend.
#   direct = gateway POSTs batches over HTTPS (no broker; right for small sites and evaluation)
#   kafka  = gateway produces to Redpanda/Kafka (right for large fleets and burst absorption)
EVENT_BUS=direct
KAFKA_BROKERS=redpanda:29092
KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644
# KAFKA_SSL=true
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SASL_MECHANISM=scram-sha-512

# Bearer token edge gateways authenticate with. CHANGE THIS. A gateway that presents a valid token
# still cannot inject events until an administrator enables it in Communications -> Gateways.
INGEST_TOKEN=dev-only-ingest-token-change-me
INGEST_RATE_LIMIT_PER_MINUTE=6000

# --- Edge Gateway (set these on the gateway host, not the backend) ---------------------------
GATEWAY_ID=gateway-docker-demo
# SIMULATE=false on real hardware. Left true so the platform is demonstrable with no field devices.
GATEWAY_SIMULATE=true
INGEST_URL=http://api:4000/api/ingest/events
# Which site this gateway serves. Province/city only — there is deliberately no coordinate setting.
# SITE_PROJECT_ID=
# SITE_PROVINCE_ID=
# SITE_CITY_ID=
# Layer-2 interface for GOOSE / Sampled Values. The gateway needs CAP_NET_RAW to use these.
# GOOSE_INTERFACE=eth0
# Path to a native IEC 61850 stack binding (libiec61850). Without it, 61850 runs in simulator mode.
# IEC61850_NATIVE_ADAPTER=/opt/iec61850/adapter.js
# Offset reported by the local PTP daemon, used for time-sync supervision.
# PTP_OFFSET_MS=

# --- AI --------------------------------------------------------------------------------------
# Leave these UNSET to run the deterministic rule engine only. Nothing then leaves the deployment.
# Point them at a model hosted inside your own network for an air-gapped utility installation.
# Any OpenAI-compatible endpoint works.
# AI_LLM_BASE_URL=http://llm.internal:8000/v1
# AI_LLM_MODEL=
# AI_LLM_API_KEY=
# AI_TIMEOUT_MS=45000
# Embeddings enable semantic retrieval over the knowledge base. Without them, retrieval falls back
# to Postgres full-text search, which still works well for relay codes and ANSI numbers.
# AI_EMBEDDING_BASE_URL=http://llm.internal:8000/v1
# AI_EMBEDDING_MODEL=
# AI_EMBEDDING_API_KEY=
